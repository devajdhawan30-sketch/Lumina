    },
    {
      "id": "example-zeros",
      "question": "Find the zeros of \\(\\cos x\\).",
      "solution": "Cosine is zero whenever the corresponding unit-circle point lies on the vertical axis. Therefore, \\(x=\\frac{\\pi}{2}+k\\pi\\), where \\(k\\in\\mathbb{Z}\\)."
    },
