  "theory": {
    "introduction": "Some trigonometric equations can be factored using familiar algebraic techniques before solving each factor.",
    "sections": [
      {
        "id": "zero-product",
        "title": "Zero Product Property",
        "content": [
          {
            "type": "paragraph",
            "text": "If a product equals zero, at least one factor must equal zero. This allows a complicated trigonometric equation to be separated into simpler equations.",
            "id": "zero-product-paragraph-1"
          }
        ]
      },
      {
        "id": "factoring-process",
        "title": "Factoring Process",
        "content": [
          {
            "type": "paragraph",
            "text": "Move all terms to one side, factor the expression, solve each factor, and combine all valid solutions.",
            "id": "factoring-process-paragraph-1"
          }
        ]
      }
    ]
  },
  "formulas": [
    {
      "id": "zero-product",
      "name": "Zero Product Property",
      "expression": "AB = 0  ⇒  A = 0 or B = 0",
      "explanation": "Used after factoring an equation."
    }
  ],
  "examples": [
    {
      "id": "factoring-example",
      "question": "Solve 2sin²(x) − sin(x) = 0 for 0 ≤ x < 2π.",
      "solution": "Factor: sin(x)(2sin(x) − 1) = 0. Thus sin(x) = 0 or sin(x) = 1/2. The solutions are 0, π, π/6, and 5π/6."
    }
  ],
  "key_ideas": [
    "Treat trigonometric expressions algebraically when possible.",
    "Factor before applying more complicated identities.",
    "Solve every resulting equation."
  ],
  "misconceptions": [
    "Dividing by sin(x) and accidentally removing sin(x) = 0 solutions.",
    "Solving only one factor."
  ],
  "explorations": [
