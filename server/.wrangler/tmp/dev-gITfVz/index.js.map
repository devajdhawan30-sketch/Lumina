  "formulas": [
    {
      "id": "multiple-angle-example",
      "name": "Basic Multiple-Angle Pattern",
      "expression": "cos(2x) = 0  ⇒  2x = π/2 + nπ",
      "explanation": "Solve for the multiple angle first, then divide by 2."
    }
  ],
  "examples": [
    {
      "id": "double-angle-example",
      "question": "Solve cos(2x) = 0 for 0 ≤ x < 2π.",
      "solution": "2x = π/2 + nπ. Therefore x = π/4 + nπ/2. The solutions are π/4, 3π/4, 5π/4, and 7π/4."
    }
  ],
  "key_ideas": [
    "Solve for the multiple angle first.",
    "Generate every solution in the relevant interval.",
    "Divide by the coefficient only after accounting for all solutions."
  ],
