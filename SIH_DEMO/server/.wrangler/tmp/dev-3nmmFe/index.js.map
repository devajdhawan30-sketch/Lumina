{
  "id": "trig-equations-06",
  "title": "Quadratic Trigonometric Equations",
  "subject": "mathematics",
  "topic": "trigonometry",
  "section": "trigonometric-equations",
  "difficulty": 3,
  "connections": {
    "prerequisites": [
      "trig-equations-03",
      "trig-equations-05",
